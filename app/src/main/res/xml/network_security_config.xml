<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        ═══════════════════════════════════════════════════════════════════
        KONFIGURASI TRUST ANCHOR — api.nexadev.my.id

        LATAR BELAKANG
        api.nexadev.my.id memakai sertifikat Let's Encrypt dengan rantai:
            api.nexadev.my.id
              <- YR1 (Let's Encrypt)
              <- Root YR (ISRG)
              <- ISRG Root X1 (root, cross-signed)

        ISRG Root X1 adalah CA publik yang sudah ada di system store Android
        7+ (SSL Labs: grade A, Android isTrusted = true). Namun sebagian device
        (ROM custom, device lama, atau update CA tertunda) belum punya root ini,
        sehingga muncul:
            CertPathValidatorException: Trust Anchor for certification path
            not found

        PENYELESAIAN
        Root ISRG X1 ditanam sebagai trust anchor TAMBAHAN lewat mekanisme
        resmi Android (raw resource), sehingga device yang system store-nya
        belum punya root ini tetap bisa memvalidasi rantai secara PENUH.

        Ini BUKAN trust-all-certs:
          - `system` tetap dipakai (CA publik resmi).
          - `user` tetap dipakai (default Android).
          - Hanya SATU CA publik yang sah (ISRG Root X1) yang ditambahkan,
            dan hanya untuk domain api.nexadev.my.id.
          - Tidak ada SSLSocketFactory custom, tidak ada TrustManager yang
            menerima semua, tidak ada HostnameVerifier yang selalu true.
    -->
    <domain-config>
        <domain includeSubdomains="true">api.nexadev.my.id</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </domain-config>

    <!-- Domain lain memakai base-config (system + user). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config>
        <domain includeSubdomains="true">api.siputzx.my.id</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>